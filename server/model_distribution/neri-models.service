[Unit]
Description=Neri model distribution service
After=network-online.target openlist.service
Wants=network-online.target

[Service]
Type=simple
User=neri-models
Group=neri-models
WorkingDirectory=/opt/neri-models
EnvironmentFile=/etc/neri-models.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/neri-models/venv/bin/uvicorn server.model_distribution.asgi:app --host 127.0.0.1 --port 8002 --workers 1 --no-access-log --no-proxy-headers
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/neri-models
MemoryMax=512M

[Install]
WantedBy=multi-user.target
