# =========================
# Custom Exclusions
# =========================
toolkit/
app/
temp/
logs/
# Local experiments, downloaded dependencies, test scratch data and rollback copies.
# Reusable tools live in scripts/; curated experiment records live in docs/experiments/.
/runs/
/backup-*.bundle
/detections.db
/detections.db-*

