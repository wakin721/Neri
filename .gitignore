# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/
/tests/
!/tests/
/tests/*
!/tests/__init__.py
!/tests/test_training_upload.py
!/tests/test_training_privacy_api.py
!/tests/test_training_transport.py
!/tests/test_training_broker.py

# Build outputs
build/
dist/
/Neri.exe
/Neri.pdb
/launcher.obj
/launcher.res
/native_assets.json
/gui.py
/checker.py

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# IDE and OS files
.idea/
*.iml
.DS_Store
Thumbs.db
.vs/

# =========================
# Custom Exclusions
# =========================
toolkit/
app/
temp/
logs/

# 忽略 frontend 文件夹下的所有内容，但保留 lib 文件夹
frontend/*
!frontend/lib/
!frontend/lib/**
!frontend/test/
frontend/test/*
!frontend/test/app_updater_test.dart
!frontend/test/close_behavior_test.dart
!frontend/test/job_result_refresh_test.dart
!frontend/test/model_selection_test.dart
!frontend/test/package_source_resolution_test.dart
!frontend/test/privacy_test.dart
!frontend/pubspec.yaml
!frontend/assets/
!frontend/assets/**
# Keep Neri's customized Windows shell integration under version control.
!frontend/windows/
frontend/windows/*
!frontend/windows/runner/
frontend/windows/runner/*
!frontend/windows/runner/flutter_window.cpp
!frontend/windows/runner/flutter_window.h
!frontend/windows/runner/main.cpp
!frontend/windows/runner/win32_window.cpp
!frontend/windows/runner/win32_window.h
